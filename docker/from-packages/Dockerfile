FROM rockylinux:8

# some descriptive metadata - docker image inspect
LABEL org.opencontainers.image.title="數位發展部 MODA ODFWEB 雲端編輯工具"
ARG author
LABEL org.opencontainers.image.authors=${author:-"Ministry of Digital Affairs <odf@moda.gov.tw>"}
LABEL org.opencontainers.image.description="數位發展部 ODFWEB 雲端編輯工具，是因應過去在移動裝置上讀取 ODF 文件不便的原因而發展，透過建置獨立的線上編輯器，用戶裝置不需另外安裝獨立 APP 即可透過手機瀏覽器來讀取或是簡易編輯文件檔案，後來因為 Covid-19 疫情及勒索病毒攻擊等因素，居家辦公及遠距溝通需求大增，因而成為機關用以解決上述情境辦公需求的解決方案之一。數位發展部運用開源軟體為基礎，開發 ODFWEB 雲端編輯工具，提供導入單位利用行動裝置透過網頁，線上編輯 ODF 文件的解決方案。"
ARG releasenotes
LABEL release.notes=${releasenotes:-"https://free.nchc.org.tw/ndc.odf/odfweb/odfweb3發行註記.txt"}
ARG version
LABEL org.opencontainers.image.version=${version:-"3.8-dev"}

# UTF-8 locale is needed to handle file names with non-ASCII characters
ENV LC_CTYPE=C.UTF-8

RUN --mount=type=bind,source=.,target=/build-context \
# Expand unmatched filename expansion expression to null
    shopt -s nullglob; \
# Install dependencies for setting up external repositories
    dnf install -y curl && \
# Setup MODAODFWEB v3.8 repo
    curl --output /etc/yum.repos.d/modaodfweb-v3.8-el8.repo https://free.nchc.org.tw/odfrepo/online/modaodfweb-v3.8-el8.repo && \
# Setup EPEL repository, which provides dependency package for the poco-odbc package
    dnf install -y epel-release && \
# Install pre-built MODAODFWEB and its runtime dependencies from the repo
    dnf groupinstall -y "MODAODFWEB Group" && \
# Install pre-built MODAODFWEB and its runtime dependencies from local packages
    #dnf install -y /build-context/modaodfsys-new/*.rpm /build-context/modaodfweb-3.8.*.el*.*.rpm /build-context/poco-libs/*.rpm && \
# Install dependency for the start script
    dnf install -y openssl && \
# Fix ownership of config directory that will be modified on start of the container by lool user
    chown lool:lool /etc/modaodfweb && \
# Cleanup
    dnf clean all && \
# Remove WOPI Proof key generated by the package, we need unique key for each container
    rm -rf /etc/modaodfweb/proof_key*

COPY /scripts/docker-entrypoint.sh /docker-entrypoint.sh

# modaodfweb listens on port 9980
EXPOSE 9980

# Switch to lool user (use numeric user id to be compatible with Kubernetes Pod Security Policies)
USER 998

ENTRYPOINT ["/docker-entrypoint.sh"]

CMD ["/usr/bin/modaodfweb", "--version", "--use-env-vars", "--o:sys_template_path=/opt/modaodfweb/systemplate", "--o:child_root_path=/opt/modaodfweb/child-roots", "--o:file_server_root_path=/usr/share/modaodfweb", "--o:logging.color=false", "--o:stop_on_config_change=true"]

VOLUME ["/etc/modaodfweb"]
